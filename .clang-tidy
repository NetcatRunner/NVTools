---
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  google-build-using-namespace,
  google-explicit-constructor,
  google-global-names-in-headers,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -portability-avoid-pragma-once,
  -readability-braces-around-statements,
  -readability-identifier-length,
  -readability-use-concise-preprocessor-directives
ExtraArgs: ['-Wno-unknown-warning-option']   # GCC-only warnings in compile_commands.json
WarningsAsErrors: '*'
HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|.*/)(build|vcpkg_installed|\.venv)/.*'
FormatStyle: file
CheckOptions:
  bugprone-exception-escape.IgnoredExceptions: 'bad_alloc,length_error,format_error'
  bugprone-unused-return-value.AllowCastToVoid: true
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
  cppcoreguidelines-macro-usage.AllowedRegexp: '^NVTOOLS_'
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
  cppcoreguidelines-special-member-functions.AllowMissingMoveFunctionsWhenCopyIsDeleted: true
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  readability-function-cognitive-complexity.Threshold: 25
  readability-function-cognitive-complexity.IgnoreMacros: true
  readability-function-size.LineThreshold: 100
  readability-function-size.ParameterThreshold: 3
  readability-identifier-naming.NamespaceCase: CamelCase
  readability-identifier-naming.NamespaceIgnoredRegexp: '^detail$'
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.AbstractClassCase: CamelCase
  readability-identifier-naming.AbstractClassPrefix: I
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.EnumConstantCase: CamelCase
  readability-identifier-naming.ScopedEnumConstantCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.FunctionCase: camelBack
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.LocalVariableCase: camelBack
  readability-identifier-naming.PublicMemberCase: camelBack
  readability-identifier-naming.PrivateMemberCase: camelBack
  readability-identifier-naming.PrivateMemberPrefix: _
  readability-identifier-naming.ProtectedMemberCase: camelBack
  readability-identifier-naming.ProtectedMemberPrefix: _
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k
  readability-identifier-naming.ClassConstantCase: CamelCase
  readability-identifier-naming.ClassConstantPrefix: k
  readability-identifier-naming.GlobalVariableCase: CamelCase
  readability-identifier-naming.GlobalVariablePrefix: g
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.TypeAliasIgnoredRegexp: '^(value_type|size_type|difference_type|reference|const_reference|pointer|const_pointer|iterator|const_iterator|reverse_iterator|const_reverse_iterator|iterator_category|iterator_concept|element_type|key_type|mapped_type|key_compare|value_compare|allocator_type|hasher|key_equal|is_transparent|char_type|traits_type|result_type)$'
  readability-identifier-naming.MethodIgnoredRegexp: '^(push_back|emplace_back|pop_back|push_front|emplace_front|pop_front|try_emplace|insert_or_assign|max_size|shrink_to_fit|lower_bound|upper_bound|equal_range|get_allocator|cbegin|cend|rbegin|rend|crbegin|crend)$'
